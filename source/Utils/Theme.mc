import Toybox.Graphics;
import Toybox.Lang;
import Toybox.Math;
import Toybox.System;
import Toybox.WatchUi;

//! RESTORA design tokens: "Calm Precision".
//! Black AMOLED canvas, forest surfaces, sage/mint accents, ivory text, and
//! Roboto Mono for every glyph (bitmap fonts generated by tools/make_fonts.py).
module Theme {

    // ---- Palette ---------------------------------------------------------
    const BG = 0x000000;        // AMOLED black (pixels off = battery saved)
    const DEEP = 0x142A22;      // Deep Forest: primary surface
    const SURFACE = 0x243F33;   // Forest: focused rows, inactive ring segments
    const SAGE = 0x8FAF96;      // accent, labels
    const MINT = 0xC7DCC9;      // highlight, active state, progress
    const IVORY = 0xF1EEE4;     // primary text
    const GREY = 0x77847B;      // secondary text
    const LINE = 0x2C3631;      // hairline dividers
    const AMBER = 0xD9A441;     // paused
    const ORANGE = 0xE08A4F;    // warning
    const RED = 0xD9706A;       // error

    // ---- Fonts (lazy, cached) -------------------------------------------
    var _label = null;
    var _body = null;
    var _title = null;
    var _num = null;
    var _hero = null;

    //! 17 px Medium: uppercase labels and hints.
    function label() {
        if (_label == null) { _label = WatchUi.loadResource(Rez.Fonts.MonoLabel); }
        return _label;
    }

    //! 21 px Regular: rows and notes.
    function body() {
        if (_body == null) { _body = WatchUi.loadResource(Rez.Fonts.MonoBody); }
        return _body;
    }

    //! 27 px Bold: titles, phase words.
    function title() {
        if (_title == null) { _title = WatchUi.loadResource(Rez.Fonts.MonoTitle); }
        return _title;
    }

    //! 50 px Bold digits: data-field values.
    function num() {
        if (_num == null) { _num = WatchUi.loadResource(Rez.Fonts.MonoNum); }
        return _num;
    }

    //! 100 px Bold digits: the main timer.
    function hero() {
        if (_hero == null) { _hero = WatchUi.loadResource(Rez.Fonts.MonoHero); }
        return _hero;
    }

    //! Release the big fonts when leaving the session HUD.
    function releaseLarge() as Void {
        _num = null;
        _hero = null;
    }

    // ---- Layout helpers --------------------------------------------------

    function cx(dc as Graphics.Dc) as Number { return dc.getWidth() / 2; }
    function cy(dc as Graphics.Dc) as Number { return dc.getHeight() / 2; }

    //! y position as a per-mille of screen height (layouts are resolution-relative).
    function y(dc as Graphics.Dc, permille as Number) as Number {
        return dc.getHeight() * permille / 1000;
    }

    //! Half-width of the round screen's chord at height y.
    function chordHalf(dc as Graphics.Dc, yy as Number) as Number {
        var r = dc.getWidth() / 2;
        var d = yy - r;
        var sq = r * r - d * d;
        return (sq > 0) ? Math.sqrt(sq).toNumber() : 0;
    }

    function text(dc as Graphics.Dc, x as Number, yy as Number, font, color as Number, s as String, just as Number) as Void {
        dc.setColor(color, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x, yy, font, s, just);
    }

    function centerText(dc as Graphics.Dc, yy as Number, font, color as Number, s as String) as Void {
        text(dc, cx(dc), yy, font, color, s, Graphics.TEXT_JUSTIFY_CENTER);
    }

    //! Horizontal hairline across the round screen at y, inset by `inset` px.
    function divider(dc as Graphics.Dc, yy as Number, inset as Number) as Void {
        var half = chordHalf(dc, yy) - inset;
        if (half <= 0) {
            return;
        }
        dc.setPenWidth(1);
        dc.setColor(LINE, Graphics.COLOR_TRANSPARENT);
        dc.drawLine(cx(dc) - half, yy, cx(dc) + half, yy);
    }

    //! Truncate s with "." so it fits maxWidth pixels in font (mono = cheap).
    function fit(dc as Graphics.Dc, s as String, font, maxWidth as Number) as String {
        if (dc.getTextWidthInPixels(s, font) <= maxWidth) {
            return s;
        }
        var n = s.length();
        while (n > 1 && dc.getTextWidthInPixels(s.substring(0, n) + ".", font) > maxWidth) {
            n--;
        }
        return s.substring(0, n) + ".";
    }

    //! Short mint arc on the bezel next to the START button (FR165: 2 o'clock).
    function startHint(dc as Graphics.Dc) as Void {
        var r = dc.getWidth() / 2 - 4;
        dc.setPenWidth(6);
        dc.setColor(MINT, Graphics.COLOR_TRANSPARENT);
        dc.drawArc(cx(dc), cy(dc), r, Graphics.ARC_COUNTER_CLOCKWISE, 22, 38);
        dc.setPenWidth(1);
    }

    //! "HH:MM" local time.
    function clock() as String {
        var t = System.getClockTime();
        return t.hour.format("%02d") + ":" + t.min.format("%02d");
    }
}
