import Toybox.Graphics;
import Toybox.Lang;
import Toybox.Math;
import Toybox.System;
import Toybox.WatchUi;

//! RESTORA design tokens: sport-tech instrumentation on AMOLED black.
//! Roboto Condensed bitmap fonts are generated by tools/make_fonts.py.
module Theme {

    // ---- Palette ---------------------------------------------------------
    const BG = 0x000000;        // AMOLED black
    const SURFACE = 0x17211B;   // focused row, pills
    const TRACK = 0x26302A;     // ring / bar track, inactive segments
    const LINE = 0x2A322D;      // hairlines
    const GREEN = 0x4FC97A;     // accent: active, progress, titles in HUD
    const GREEN_DIM = 0x2C6B45;
    const WHITE = 0xF2F3EF;     // primary text and numbers
    const SOFT = 0xC9CEC9;      // unfocused names and icons
    const GREY = 0x8A918C;      // secondary text, labels
    const AMBER = 0xE2A93B;     // paused
    const RED = 0xE06C61;       // error

    // ---- Fonts (lazy, cached). Line heights in px: 18 / 21 / 24 / 29 / 48 / 71
    var _label = null;
    var _small = null;
    var _body = null;
    var _title = null;
    var _num = null;
    var _hero = null;

    //! 15 px Medium: small uppercase labels.
    function label() {
        if (_label == null) { _label = WatchUi.loadResource(Rez.Fonts.Label); }
        return _label;
    }

    //! 17 px Regular: subtitles, cues, table rows.
    function small() {
        if (_small == null) { _small = WatchUi.loadResource(Rez.Fonts.Small); }
        return _small;
    }

    //! 20 px Medium: list names, clock, info row.
    function body() {
        if (_body == null) { _body = WatchUi.loadResource(Rez.Fonts.Body); }
        return _body;
    }

    //! 24 px Bold: titles, phase word, metric values.
    function title() {
        if (_title == null) { _title = WatchUi.loadResource(Rez.Fonts.Title); }
        return _title;
    }

    //! 40 px Bold digits: headline numbers.
    function num() {
        if (_num == null) { _num = WatchUi.loadResource(Rez.Fonts.Num); }
        return _num;
    }

    //! 60 px Bold digits: the timer inside the HUD ring.
    function hero() {
        if (_hero == null) { _hero = WatchUi.loadResource(Rez.Fonts.Hero); }
        return _hero;
    }

    //! Release the big fonts when leaving number-heavy screens.
    function releaseLarge() as Void {
        _num = null;
        _hero = null;
    }

    // ---- Layout ----------------------------------------------------------
    // Layouts are specified in px of a 390 px round screen (FR165) and scaled.
    // Safe circles (390-px units): content never crosses these radii.
    const SAFE_HUD = 160;
    const SAFE_PAGE = 170;
    const SAFE_MENU = 164;

    function cx(dc as Graphics.Dc) as Number { return dc.getWidth() / 2; }
    function cy(dc as Graphics.Dc) as Number { return dc.getHeight() / 2; }

    //! Scale a 390-px design value to this screen.
    //! Uses the device screen height, not the dc: inside a CustomMenuItem the
    //! dc is only one row tall, which would shrink every size to a quarter.
    function px(dc as Graphics.Dc, v) as Number {
        if (_screenH == 0) {
            _screenH = System.getDeviceSettings().screenHeight;
        }
        return (v * _screenH / 390).toNumber();
    }

    var _screenH as Number = 0;

    //! Half-width of the safe circle (radius r, 390-px units) at screen y.
    function safeHalf(dc as Graphics.Dc, yy as Number, r as Number) as Number {
        var rr = px(dc, r);
        var d = yy - cy(dc);
        var sq = rr * rr - d * d;
        return (sq > 0) ? Math.sqrt(sq).toNumber() : 0;
    }

    //! Usable width for a line whose box spans [top, top + h].
    function lineWidth(dc as Graphics.Dc, top as Number, h as Number, r as Number) as Number {
        var a = safeHalf(dc, top, r);
        var b = safeHalf(dc, top + h, r);
        return 2 * ((a < b) ? a : b);
    }

    function text(dc as Graphics.Dc, x as Number, yy as Number, font, color as Number, s as String, just as Number) as Void {
        dc.setColor(color, Graphics.COLOR_TRANSPARENT);
        dc.drawText(x, yy, font, s, just);
    }

    function centerText(dc as Graphics.Dc, yy as Number, font, color as Number, s as String) as Void {
        text(dc, cx(dc), yy, font, color, s, Graphics.TEXT_JUSTIFY_CENTER);
    }

    //! Truncate s with "." so it fits maxWidth pixels in font.
    function fit(dc as Graphics.Dc, s as String, font, maxWidth as Number) as String {
        if (dc.getTextWidthInPixels(s, font) <= maxWidth) {
            return s;
        }
        var n = s.length();
        while (n > 1 && dc.getTextWidthInPixels(s.substring(0, n) + ".", font) > maxWidth) {
            n--;
        }
        return s.substring(0, n) + ".";
    }

    //! Centred line inside safe circle r: tries `font`, then `smaller`, then truncates.
    function fitLine(dc as Graphics.Dc, yy as Number, s as String, font, smaller, r as Number, color as Number) as Void {
        var w = lineWidth(dc, yy, dc.getFontHeight(font), r) - px(dc, 8);
        var f = font;
        if (smaller != null && dc.getTextWidthInPixels(s, font) > w) {
            f = smaller;
        }
        centerText(dc, yy, f, color, fit(dc, s, f, w));
    }

    //! Hairline at y spanning the safe circle r, inset by `inset` px.
    function divider(dc as Graphics.Dc, yy as Number, r as Number, inset as Number) as Void {
        var half = safeHalf(dc, yy, r) - inset;
        if (half <= 0) {
            return;
        }
        dc.setPenWidth(1);
        dc.setColor(LINE, Graphics.COLOR_TRANSPARENT);
        dc.drawLine(cx(dc) - half, yy, cx(dc) + half, yy);
    }

    //! Rounded action pill (e.g. "Start", "Done"), 120 x 30 at y (390-px units).
    function pill(dc as Graphics.Dc, y as Number, label as String) as Void {
        var w = px(dc, 120);
        var h = px(dc, 30);
        var yy = px(dc, y);
        dc.setColor(SURFACE, Graphics.COLOR_TRANSPARENT);
        dc.fillRoundedRectangle(cx(dc) - w / 2, yy, w, h, h / 2);
        centerText(dc, yy + px(dc, 1), title(), GREEN, label);
    }

    //! Short green arc on the bezel next to the START button (FR165: 2 o'clock).
    function startHint(dc as Graphics.Dc) as Void {
        var r = dc.getWidth() / 2 - 4;
        dc.setPenWidth(6);
        dc.setColor(GREEN, Graphics.COLOR_TRANSPARENT);
        dc.drawArc(cx(dc), cy(dc), r, Graphics.ARC_COUNTER_CLOCKWISE, 22, 38);
        dc.setPenWidth(1);
    }

    //! "HH:MM" local time.
    function clock() as String {
        var t = System.getClockTime();
        return t.hour.format("%02d") + ":" + t.min.format("%02d");
    }
}
